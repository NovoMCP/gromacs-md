; NPT equilibration stage 1 — restrained protein + lipid headgroups
; Semi-isotropic pressure coupling (XY independent of Z)
; Step 3 of 6

integrator              = md
dt                      = 0.002      ; 2 fs
nsteps                  = 2500000    ; 5 ns
nstxout-compressed      = 5000
nstenergy               = 1000
nstlog                  = 1000

; Temperature coupling
tcoupl                  = V-rescale
tc-grps                 = Protein POPC Water_and_ions
tau_t                   = 0.1 0.1 0.1
ref_t                   = {temperature} {temperature} {temperature}

; Pressure coupling — SEMI-ISOTROPIC for membranes
; XY (membrane plane) coupled together, Z (normal) independent
pcoupl                  = C-rescale
pcoupltype              = semiisotropic
tau_p                   = 5.0
ref_p                   = 1.0 1.0
compressibility         = 4.5e-5 4.5e-5

; Neighbor searching
nstlist                 = 20
cutoff-scheme           = Verlet
pbc                     = xyz

; Electrostatics
coulombtype             = PME
rcoulomb                = 1.2
fourierspacing          = 0.12

; Van der Waals
vdwtype                 = Cut-off
vdw-modifier            = force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2
DispCorr                = no

; Constraints
constraints             = h-bonds
constraint_algorithm    = LINCS
lincs_iter              = 1
lincs_order             = 4

; Velocity from NVT — no generation
gen-vel                 = no

; Position restraints — both protein and lipid headgroups
define                  = -DPOSRES -DPOSRES_LIP
